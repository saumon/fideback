<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      /* Les clients mail ignorent souvent <style> : l'essentiel est aussi posé en ligne. */
      a { color: #231942; }
    </style>
  </head>

  <body style="margin: 0; padding: 0; background: #F7F5FC; color: #231942; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 16px; line-height: 1.6;">
    <div style="max-width: 560px; margin: 0 auto; padding: 32px 20px;">
      <p style="margin: 0 0 20px; font-size: 22px; font-weight: bold; color: #231942;">Fideback</p>
      <div style="height: 6px; border-radius: 6px 6px 0 0; background: linear-gradient(90deg, #FF5D8F 0 16.6%, #FFB627 16.6% 33.3%, #12B886 33.3% 50%, #2F8CFF 50% 66.6%, #B05CF0 66.6% 83.3%, #9BD12E 83.3%); background-color: #FF5D8F;"></div>
      <div style="background: #FFFFFF; border: 2px solid #231942; border-top: 0; border-radius: 0 0 16px 16px; padding: 24px 28px;">
        <%= yield %>
      </div>
    </div>
  </body>
</html>
