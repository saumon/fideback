<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      /* Les clients mail ignorent souvent <style> : l'essentiel est aussi posé en ligne. */
      a { color: #2F5D8C; }
    </style>
  </head>

  <body style="margin: 0; padding: 0; background: #F7F8F6; color: #16222E; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 16px; line-height: 1.6;">
    <div style="max-width: 560px; margin: 0 auto; padding: 32px 20px;">
      <p style="margin: 0 0 24px; font-family: Georgia, 'Times New Roman', serif; font-size: 22px; font-weight: bold; color: #16222E;">Fideback</p>
      <div style="background: #FFFFFF; border-top: 3px solid #2F5D8C; padding: 24px 28px;">
        <%= yield %>
      </div>
    </div>
  </body>
</html>
