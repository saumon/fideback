<!DOCTYPE html>
<html lang="fr">
  <head>
    <title>Fideback — <%= @campaign&.name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="respondent">
    <header class="site-header"><span class="brand"><span class="brand-dots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>Fideback</span></header>
    <main>
      <% flash.each do |type, message| %>
        <p class="flash flash-<%= type %>"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>

    <%= render "layouts/dev_footer" %>
  </body>
</html>
