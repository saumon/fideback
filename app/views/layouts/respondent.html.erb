<!DOCTYPE html>
<html lang="fr">
  <head>
    <title>Fideback — <%= @campaign&.name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= preload_link_tag "bricolage-grotesque.woff2" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="respondent">
    <header class="site-header"><span class="brand"><span class="brand-dots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span><span class="brand-name">Fideback</span></span></header>
    <main>
      <%= yield %>
    </main>

    <%= render "layouts/toasts" %>

    <%= render "layouts/dev_footer" %>
  </body>
</html>
