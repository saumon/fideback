<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Fideback" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Fideback">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# Police chargée dès le HTML : sans cela, le navigateur ne la découvre qu'en lisant le CSS et affiche d'abord une police de secours. %>
    <%= preload_link_tag "bricolage-grotesque.woff2" %>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="page-<%= controller_name %>">
    <header class="site-header">
      <%= link_to root_path, class: "brand" do %><span class="brand-dots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span><span class="brand-name">Fideback</span><% end %>
      <nav aria-label="Navigation principale">
        <% if manager_signed_in? %>
          <%= link_to "Mes campagnes", campaigns_path %>
          <%= link_to "Mon équipe", team_path %>
          <%= link_to "Administration", admin_root_path if current_manager.admin? %>
          <%= link_to current_manager.name, edit_manager_registration_path %>
          <%= button_to "Se déconnecter", destroy_manager_session_path, method: :delete, class: "link", form: { class: "inline" } %>
        <% else %>
          <%= link_to "Se connecter", new_manager_session_path %>
          <%= link_to "Créer un compte", new_manager_registration_path, class: "btn btn-small" %>
        <% end %>
      </nav>
    </header>

    <main>
      <%= yield %>
    </main>

    <%= render "layouts/toasts" %>

    <%= render "layouts/dev_footer" %>
  </body>
</html>
