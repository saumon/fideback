<p><%= t('.greeting', recipient: @resource.name) %></p>

<%# Une action Devise, deux e-mails : activer un nouveau compte, ou confirmer une adresse modifiée (envoyé à la nouvelle adresse). %>
<p><%= @resource.pending_reconfirmation? ? t('.instruction_reconfirmation') : t('.instruction') %></p>

<p style="margin: 24px 0;"><%= link_to t('.action'), confirmation_url(@resource, confirmation_token: @token), style: "display: inline-block; padding: 12px 24px; background: #231942; color: #FFFFFF; border-radius: 999px; box-shadow: 3px 3px 0 #FF5D8F; font-weight: bold; text-decoration: none;" %></p>

<p><%= t('.validity') %></p>
<p><%= t('.not_you') %></p>
