<header class="respondent-intro">
  <h1><%= @campaign.name %></h1>
  <p class="lead">Bonjour <%= @respondent.name %>, <%= @campaign.manager.name %> vous invite à donner votre feedback.</p>
  <p class="notice-transparency"><strong>Important :</strong> vos réponses seront communiquées nominativement à <%= @campaign.manager.name %>.</p>
</header>

<% if @respondent.submitted? %>
  <p class="flash flash-notice">Vous avez soumis vos réponses. Merci ! Elles ne sont plus modifiables.</p>
<% elsif !@campaign.accepting_answers? %>
  <p class="flash flash-alert">Cette campagne est terminée : les réponses ne sont plus acceptées.</p>
<% end %>

<% editable = @campaign.accepting_answers? && !@respondent.submitted? %>
<% missing = (@missing || []).map { |subject, question| [ subject.id, question.id ] } %>

<%= form_with url: respondent_form_path(token: @respondent.token), method: :patch, class: "answer-form" do |f| %>
  <% @respondent.subjects_to_rate.order(:name).each do |subject| %>
    <fieldset class="subject <%= voice_class(subject) %>">
      <legend data-initials="<%= initials(subject.name) %>"><%= subject.name %></legend>
      <% @campaign.questions.each do |question| %>
        <div class="field answer<%= " missing" if missing.include?([ subject.id, question.id ]) %>">
          <p class="prompt"><strong><%= question.prompt %></strong></p>
          <% if question.rating? %>
            <p class="rating" data-controller="rating">
              <%= label_tag "answers_#{subject.id}_#{question.id}_rating", "Note (1 à 5)" %>
              <span class="rating-picks">
                <% 1.upto(5) do |value| %>
                  <button type="button" class="rating-pick" data-rating-target="pick" data-action="rating#pick" data-rating-value-param="<%= value %>"
                          aria-label="Note <%= value %>" aria-pressed="false" <%= "disabled" unless editable %>><%= value %></button>
                <% end %>
              </span>
              <%= number_field_tag "answers[#{subject.id}][#{question.id}][rating]", input_value(subject, question, :rating),
                    min: 1, max: 5, step: 1, disabled: !editable, id: "answers_#{subject.id}_#{question.id}_rating",
                    data: { rating_target: "input", action: "input->rating#sync" } %>
              <% if missing.include?([ subject.id, question.id ]) %><em class="error">Note manquante</em><% end %>
            </p>
          <% end %>
          <% if question.comment? %>
            <p class="comment">
              <%= label_tag "answers_#{subject.id}_#{question.id}_body", "Commentaire" %>
              <%= text_area_tag "answers[#{subject.id}][#{question.id}][body]", input_value(subject, question, :body),
                    rows: 3, disabled: !editable, id: "answers_#{subject.id}_#{question.id}_body" %>
            </p>
          <% end %>
        </div>
      <% end %>
    </fieldset>
  <% end %>

  <% if editable %>
    <p class="actions answer-actions">
      <%= f.submit "Enregistrer et continuer plus tard", class: "btn" %>
      <%= f.submit "Soumettre définitivement", class: "btn btn-primary", formaction: submit_respondent_form_path(token: @respondent.token), formmethod: :post,
            data: { turbo_confirm: "Après soumission, vous ne pourrez plus modifier vos réponses. Continuer ?" } %>
    </p>
  <% end %>
<% end %>
