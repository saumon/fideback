<div class="page-head">
  <h1>Mes campagnes</h1>
  <p><%= link_to "Nouvelle campagne", new_campaign_path, class: "btn btn-primary" %></p>
</div>

<% if @campaigns.empty? %>
  <div class="empty">
    <p>Aucune campagne pour le moment.</p>
    <p>Une campagne réunit vos managés, les personnes à interroger et vos questions.</p>
  </div>
<% else %>
  <ul class="campaign-list">
    <% @campaigns.each_with_index do |campaign, index| %>
      <li class="voice-<%= index % ApplicationHelper::VOICE_COUNT %>">
        <span class="campaign-badge" aria-hidden="true"><%= initials(campaign.name) %></span>
        <%= link_to campaign.name, campaign, class: "campaign-name" %>
        <span class="campaign-deadline">avant le <%= l(campaign.deadline_on) %></span>
        <span class="status status-<%= campaign.status %>"><%= t("campaign_status.#{campaign.status}") %></span>
      </li>
    <% end %>
  </ul>
<% end %>
