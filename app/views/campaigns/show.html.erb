<div class="page-head">
  <h1><%= @campaign.name %></h1>
  <p class="campaign-meta">
    Statut&nbsp;: <strong class="status status-<%= @campaign.status %>"><%= t("campaign_status.#{@campaign.status}") %></strong> —
    date limite&nbsp;: <%= l(@campaign.deadline_on, format: :long) %>
  </p>
</div>

<% if @campaign.closed? && @campaign.all_submitted? %>
  <p class="callout">Clôturée : tous les sondés ont répondu.</p>
<% end %>

<% submitted = @respondents.count(&:submitted?) %>

<% if @campaign.draft? %>
  <p class="actions">
    <%= link_to "Modifier", edit_campaign_path(@campaign), class: "btn" %>
    <%= button_to "Lancer la campagne", launch_campaign_path(@campaign), class: "btn btn-primary", form: { class: "inline", data: { turbo_confirm: "Envoyer les invitations aux sondés ?", turbo_confirm_detail: "Chaque sondé reçoit son lien personnel par e-mail. Les listes ne seront plus modifiables.", turbo_confirm_icon: "send" } } %>
    <%= render "delete_button", campaign: @campaign, submitted: submitted, total: @respondents.size %>
  </p>
<% elsif @campaign.running? %>
  <p class="actions"><%= button_to "Clôturer la campagne", close_campaign_path(@campaign), class: "btn", form: { class: "inline", data: { turbo_confirm: "Clôturer la campagne ?", turbo_confirm_detail: "Les sondés ne pourront plus répondre. Les réponses déjà enregistrées restent consultables.", turbo_confirm_icon: "lock" } } %></p>
<% elsif @campaign.closed? %>
  <p class="actions"><%= render "delete_button", campaign: @campaign, submitted: submitted, total: @respondents.size %></p>
<% end %>

<h2>Sondés</h2>
<p id="response-rate">
  <%= submitted %> / <%= @respondents.size %> réponses soumises
  (<%= @respondents.empty? ? 0 : (100.0 * submitted / @respondents.size).round %> %)
</p>
<% if @respondents.any? %>
  <p class="chorus" aria-hidden="true">
    <% @respondents.sort_by { |r| r.submitted? ? 0 : 1 }.each_with_index do |respondent, index| %>
      <%= avatar(respondent, css_class: ("is-waiting" unless respondent.submitted?), title: respondent.name, style: "--i: #{index}") %>
    <% end %>
  </p>
<% end %>
<div class="table-scroll">
  <table>
    <thead><tr><th>Nom</th><th>E-mail</th><th>Statut</th><th>Invité le</th><% if @campaign.running? %><th><span class="visually-hidden">Actions</span></th><% end %></tr></thead>
    <tbody>
      <% @respondents.each do |respondent| %>
        <tr id="<%= dom_id(respondent) %>">
          <td class="cell-person"><%= avatar(respondent) %><%= respondent.name %></td>
          <td class="muted cell-email"><%= respondent.email %></td>
          <td class="cell-status"><span class="status status-<%= respondent.status %>"><%= t("respondent_status.#{respondent.status}") %></span></td>
          <td class="muted cell-invited" data-label="Invité le"><%= respondent.last_invited_at ? l(respondent.last_invited_at, format: :short) : "—" %></td>
          <% if @campaign.running? %>
            <td class="cell-action">
              <% if respondent.invitable? %>
                <%= button_to "Renvoyer", resend_campaign_respondent_path(@campaign, respondent), class: "link", form: { class: "inline", data: { turbo_confirm: "Renvoyer l'invitation à #{respondent.name} ?", turbo_confirm_detail: "Il reçoit de nouveau le même lien personnel.", turbo_confirm_icon: "send" } } %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<h2>Managés</h2>
<ul class="ledger">
  <% @subjects.each do |subject| %>
    <li>
      <%= avatar(subject) %>
      <span class="ledger-title"><%= subject.name %></span>
      <span class="muted"><%= subject.email %></span>
      <% unless @campaign.draft? %>
        <%= link_to "Synthèse", campaign_summary_path(@campaign, subject_id: subject.id), class: "ledger-action" %>
      <% end %>
    </li>
  <% end %>
</ul>

<h2>Questions</h2>
<ol class="question-list">
  <% @campaign.questions.each do |question| %>
    <li><%= question.prompt %> <small>(<%= [ ("note" if question.rating?), ("commentaire" if question.comment?) ].compact.join(" + ") %>)</small></li>
  <% end %>
</ol>

<p class="back"><%= link_to "Retour aux campagnes", campaigns_path %></p>
