<%= form_with model: campaign, class: "campaign-form" do |f| %>
  <% if campaign.errors.any? %>
    <div class="callout callout-alert">
      <ul>
        <% campaign.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <p><%= f.label :name %></p>
    <p><%= f.text_field :name %></p>
  </div>

  <div class="field field-date">
    <p><%= f.label :deadline_on %></p>
    <p><%= f.date_field :deadline_on %></p>
  </div>

  <fieldset>
    <legend>Managés <span>(personnes sur lesquelles porte le feedback)</span></legend>
    <%= render "contact_picker", campaign: campaign, list: :subjects, empty: "Aucun managé dans votre équipe pour l'instant." %>
  </fieldset>

  <fieldset>
    <legend>Sondés <span>(personnes interrogées)</span></legend>
    <%= render "contact_picker", campaign: campaign, list: :respondents, empty: "Aucun sondable dans votre équipe pour l'instant." %>
  </fieldset>

  <fieldset>
    <legend>Questions</legend>
    <%= render "nested_rows", f: f, association: :questions, partial: "question_fields",
                              blank: Question.new(rating: true, comment: true), add_label: "Ajouter une question" %>
  </fieldset>

  <p class="actions"><%= f.submit(campaign.persisted? ? "Enregistrer" : "Créer la campagne") %></p>
<% end %>
