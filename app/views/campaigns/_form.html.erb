<%= form_with model: campaign do |f| %>
  <% if campaign.errors.any? %>
    <div class="flash flash-alert">
      <ul>
        <% campaign.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <p><%= f.label :name %></p>
    <p><%= f.text_field :name %></p>
  </div>

  <div class="field">
    <p><%= f.label :deadline_on %></p>
    <p><%= f.date_field :deadline_on %></p>
  </div>

  <fieldset>
    <legend>Managés (personnes sur lesquelles porte le feedback)</legend>
    <%= render "nested_rows", f: f, association: :subjects, partial: "contact_fields",
                              blank: Subject.new, add_label: "Ajouter un managé" %>
  </fieldset>

  <fieldset>
    <legend>Sondés (personnes interrogées)</legend>
    <%= render "nested_rows", f: f, association: :respondents, partial: "contact_fields",
                              blank: Respondent.new, add_label: "Ajouter un sondé" %>
  </fieldset>

  <fieldset>
    <legend>Questions</legend>
    <%= render "nested_rows", f: f, association: :questions, partial: "question_fields",
                              blank: Question.new(rating: true, comment: true), add_label: "Ajouter une question" %>
  </fieldset>

  <p><%= f.submit(campaign.persisted? ? "Enregistrer" : "Créer la campagne") %></p>
<% end %>
